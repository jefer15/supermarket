@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Supermarket System</h1>

    @if (!(User?.Identity?.IsAuthenticated ?? false))
    {
        <p>Please <a asp-area="Identity" asp-page="/Account/Login">Login</a> or <a asp-area="Identity" asp-page="/Account/Register">Register</a> to continue.</p>
    }
    else
    {
        <p>
            Go to <a asp-controller="Products" asp-action="Index">Products</a> |
            <a asp-controller="Customers" asp-action="Index">Customers</a> |
            <a asp-controller="Sales" asp-action="Index">Sales</a> |
            <a asp-controller="Reports" asp-action="Index">Reports</a>
        </p>
    }
</div>
