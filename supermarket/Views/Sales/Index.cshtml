@model IEnumerable<supermarket.Models.Sale>

@{
    ViewData["Title"] = "Ventas";
}

<div class="container">
    <div class="d-flex justify-content-between mb-3">
        <h2 class="text-primary">
            <i class="bi bi-bag-fill"></i> Lista de Ventas
        </h2>

         <a asp-action="Create" class="btn btn-success">
              <i class="bi bi-plus-circle"></i> Nueva Venta
         </a>
    </div>

    <table class="table table-hover table-striped table-bordered align-middle  rounded">
        <thead class="table-primary text-center">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Detalles</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">
                        <i class="bi bi-info-circle"></i> No se encontraron ventas registradas.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var sale in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">@sale.Id</td>
                        <td>@sale.Customer.Name @sale.Customer.LastName</td>
                        <td class="text-center">@sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @foreach (var detail in sale.SaleDetails)
                            {
                                <div>
                                    <span class="fw-bold">@detail.Product.Name</span> -
                                    Cantidad: @detail.Quantity -
                                    Precio: @detail.UnitPrice.ToString("C")
                                </div>
                            }
                        </td>
                        <td class="text-end fw-bold">@sale.TotalAmount.ToString("C")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
