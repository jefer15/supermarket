@model supermarket.Models.ViewModels.SaleViewModel

@{
    ViewData["Title"] = "New Sale";
}

<h2>New Sale</h2>

<div>
    <label>Customer Identification:</label>
    <input type="text" id="identificationNumber" class="form-control" />
    <button type="button" class="btn btn-primary mt-2" id="btnFindCustomer">Find Customer</button>
</div>

<div id="customerInfo" class="mt-3" style="display:none;">
    <h4>Customer Information</h4>
    <p id="customerName"></p>
    <input type="hidden" id="customerId" />
</div>

<hr />

<div>
    <label>Select Product:</label>
    <select id="productSelect" class="form-control">
        <option value="">-- Select --</option>
        @foreach (var product in ViewBag.Products)
        {
            <option value="@product.Id">@product.Name</option>
        }
    </select>
    <label>Quantity:</label>
    <input type="number" id="quantity" class="form-control" min="1" value="1" />
    <button type="button" class="btn btn-success mt-2" id="btnAddProduct">Add Product</button>
</div>

<hr />

<h4>Sale Details</h4>
<table class="table table-bordered" id="saleDetailsTable">
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<button type="button" id="btnSaveSale" class="btn btn-primary">Save Sale</button>

@section Scripts {
    <script>
        let saleProducts = [];

        $("#btnFindCustomer").click(function () {
            let idNumber = $("#identificationNumber").val();
            $.post("/Sales/FindCustomer", { identificationNumber: idNumber }, function (data) {
                if (data) {
                    $("#customerId").val(data.id);
                    $("#customerName").text(data.name + " " + data.lastName);
                    $("#customerInfo").show();
                } else {
                    alert("Customer not found.");
                }
            });
        });

        $("#btnAddProduct").click(function () {
            let productId = $("#productSelect").val();
            let quantity = parseInt($("#quantity").val());

            $.ajax({
                url: "/Sales/AddProduct",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ productId: parseInt(productId), quantity: quantity }),
                success: function (data) {
                    if (data.success) {
                        saleProducts.push({
                            productId: data.productId,
                            productName: data.productName,
                            quantity: data.quantity,
                            unitPrice: data.unitPrice,
                            subtotal: data.subtotal
                        });

                        let row = `<tr>
                            <td>${data.productName}</td>
                            <td>${data.quantity}</td>
                            <td>${data.unitPrice.toFixed(2)}</td>
                            <td>${data.subtotal.toFixed(2)}</td>
                        </tr>`;

                        $("#saleDetailsTable tbody").append(row);
                    } else {
                        alert(data.message);
                    }
                }
            });
        });

        $("#btnSaveSale").click(function () {
            let customerId = parseInt($("#customerId").val());
            $.ajax({
                url: "/Sales/SaveSale",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ customerId: customerId, products: saleProducts }),
                success: function (data) {
                    if (data.success) {
                        alert(data.message);
                        window.location.href = "/Sales/Index";
                    } else {
                        alert(data.message);
                    }
                }
            });
        });
    </script>
}
