@model supermarket.Models.ViewModels.SaleViewModel

@{
    ViewData["Title"] = "Nueva Venta";
}

<div class="container">
    <h2 class="mb-4"><i class="bi bi-cart-plus text-success"></i> Nueva Venta</h2>

    <div class="mb-3">
        <label class="form-label fw-bold">Número de Identificación del Cliente:</label>
        <div class="input-group">
            <input type="text" id="identificationNumber" class="form-control" placeholder="Ingrese la identificación" />
            <button type="button" class="btn btn-primary" id="btnFindCustomer">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
    </div>

    <div id="customerInfo" class="alert alert-success p-2" style="display:none;">
        <strong>Cliente:</strong> <span id="customerName"></span>
        <input type="hidden" id="customerId" />
    </div>

    <hr />

    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label fw-bold">Seleccionar Producto:</label>
            <select id="productSelect" class="form-control">
                <option value="">-- Seleccionar --</option>
                @foreach (var product in ViewBag.Products)
                {
                    <option value="@product.Id">@product.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Cantidad:</label>
            <input type="number" id="quantity" class="form-control" min="1" value="1" />
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-success w-100" id="btnAddProduct">
                <i class="bi bi-plus-circle"></i> Agregar Producto
            </button>
        </div>
    </div>

    <hr />

    <h4>Detalles de la Venta</h4>
    <table class="table table-bordered" id="saleDetailsTable">
        <thead class="table-secondary text-center">
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio Unitario</th>
                <th>Subtotal</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <div class="text-end mt-3">
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <button type="button" id="btnSaveSale" class="btn btn-primary">
            <i class="bi bi-save"></i> Guardar Venta
        </button>
    </div>
</div>

<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-labelledby="createCustomerModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="createCustomerForm">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="createCustomerModalLabel">Crear Cliente</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Número de Identificación</label>
            <input type="text" class="form-control" id="identificationNumberModal" name="IdentificationNumber" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" name="Name" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Apellidos</label>
            <input type="text" class="form-control" name="LastName" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Dirección</label>
            <input type="text" class="form-control" name="Address" />
          </div>
          <div class="mb-3">
            <label class="form-label">Teléfono</label>
            <input type="text" class="form-control" name="Phone" />
          </div>
          <div class="mb-3">
            <label class="form-label">Correo</label>
            <input type="email" class="form-control" name="Email" />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>


@section Scripts {
    <script>
        let saleProducts = [];
        let editIndex = -1;

        function resetForm() {
            editIndex = -1;
            $("#btnAddProduct").html('<i class="bi bi-plus-circle"></i> Add Product');
            $("#productSelect").val("");
            $("#quantity").val(1);
        }

        function updateTotal() {
            let total = saleProducts.reduce((sum, p) => sum + p.subtotal, 0);
            if ($("#saleTotalRow").length === 0) {
                $("#saleDetailsTable tfoot").remove();
                $("#saleDetailsTable").append(`
                    <tfoot>
                        <tr id="saleTotalRow">
                            <th colspan="3" class="text-end">TOTAL:</th>
                            <th class="text-end" id="saleTotal">0.00</th>
                            <th></th>
                        </tr>
                    </tfoot>
                `);
            }
            $("#saleTotal").text(total.toFixed(2));
        }

        $("#btnFindCustomer").click(function () {
            let idNumber = $("#identificationNumber").val().trim();
            if (!idNumber) {
                alert("Please enter an identification number.");
                return;
            }
            $.post("/Sales/FindCustomer", { identificationNumber: idNumber }, function (data) {
                if (data) {
                    $("#customerId").val(data.id);
                    $("#customerName").text(data.name + " " + data.lastName);
                    $("#customerInfo").show();
                } else {
                    if (confirm("Customer not found. Do you want to create one?")) {
                        $("#createCustomerModal").modal("show");
                        $("#identificationNumberModal").val(idNumber);
                    }
                }
            });
        });

        $("#createCustomerForm").submit(function (e) {
            e.preventDefault();

            $.ajax({
                url: "/Customers/CreateCustomerAjax",
                type: "POST",
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        $("#customerId").val(response.customer.id);
                        $("#customerName").text(response.customer.name + " " + response.customer.lastName);
                        $("#customerInfo").show();
                        $("#identificationNumber").val($("#identificationNumberModal").val());
                        $("#createCustomerModal").modal("hide");
                    } else {
                        alert("Error creating customer: " + response.message);
                    }
                }
            });
        });

        $("#btnAddProduct").click(function () {
            let productId = $("#productSelect").val();
            let quantity = parseInt($("#quantity").val());

            if (!productId) {
                alert("Please select a product.");
                return;
            }

            if (quantity < 1) {
                alert("Quantity must be at least 1.");
                return;
            }

            if (editIndex !== -1) {
                saleProducts[editIndex].quantity = quantity;
                saleProducts[editIndex].subtotal = quantity * saleProducts[editIndex].unitPrice;

                let row = $("#saleDetailsTable tbody tr").eq(editIndex);
                row.find("td").eq(1).text(quantity);
                row.find("td").eq(3).text(saleProducts[editIndex].subtotal.toFixed(2));
                updateTotal();
                resetForm();
                return;
            }

            if (saleProducts.some(p => p.productId == productId)) {
                alert("This product has already been added.");
                resetForm();
                return;
            }

            $.ajax({
                url: "/Sales/AddProduct",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ productId: parseInt(productId), quantity: quantity }),
                success: function (data) {
                    if (data.success) {
                        saleProducts.push({
                            productId: data.productId,
                            productName: data.productName,
                            quantity: data.quantity,
                            unitPrice: data.unitPrice,
                            subtotal: data.subtotal
                        });

                        let row = `<tr>
                            <td>${data.productName}</td>
                            <td class="text-center">${data.quantity}</td>
                            <td class="text-end">${data.unitPrice.toFixed(2)}</td>
                            <td class="text-end">${data.subtotal.toFixed(2)}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-warning btn-sm btnEdit">Edit</button>
                                <button type="button" class="btn btn-danger btn-sm btnDelete">Delete</button>
                            </td>
                        </tr>`;
                        $("#saleDetailsTable tbody").append(row);
                        updateTotal();
                        resetForm();
                    } else {
                        alert(data.message);
                    }
                }
            });
        });

        $(document).on("click", ".btnEdit", function () {
            editIndex = $(this).closest("tr").index();
            let product = saleProducts[editIndex];

            $("#productSelect").val(product.productId);
            $("#quantity").val(product.quantity);

            $("#btnAddProduct").html('<i class="bi bi-save"></i> Update Product');
        });

        $(document).on("click", ".btnDelete", function () {
            let rowIndex = $(this).closest("tr").index();
            let productName = saleProducts[rowIndex].productName;

            if (confirm(`Are you sure you want to remove "${productName}"?`)) {
                saleProducts.splice(rowIndex, 1);
                $(this).closest("tr").remove();
                updateTotal();
            }
        });


        $("#btnSaveSale").click(function () {
            let customerId = parseInt($("#customerId").val());
            if (!customerId) {
                alert("Please select a customer.");
                return;
            }
            if (saleProducts.length === 0) {
                alert("Please add at least one product.");
                return;
            }

            $.ajax({
                url: "/Sales/SaveSale",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ customerId: customerId, products: saleProducts }),
                success: function (data) {
                    if (data.success) {
                        alert(data.message);
                        window.location.href = "/Sales/Index";
                    } else {
                        alert(data.message);
                    }
                }
            });
        });
    </script>
}
