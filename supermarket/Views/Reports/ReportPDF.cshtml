@model IEnumerable<supermarket.Models.Sale>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sales Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        table, th, td {
            border: 1px solid black;
            padding: 8px;
        }

        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>
    <h2>Sales Report</h2>
    <table>
        <thead>
            <tr>
                <th>Sale ID</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sale in Model)
            {
                <tr>
                    <td>@sale.Id</td>
                    <td>@sale.Customer.Name @sale.Customer.LastName</td>
                    <td>@sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@sale.TotalAmount.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
