@model supermarket.Models.Customer
@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-trash"></i> Eliminar Cliente</h4>
        </div>
        <div class="card-body">
            <p class="fw-bold">¿Estás seguro de que deseas eliminar este cliente?</p>
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.IdentificationNumber)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.IdentificationNumber)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Name)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Name)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.LastName)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.LastName)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Address)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Address)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Phone)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Phone)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Email)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Email)</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-check-circle"></i> Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
