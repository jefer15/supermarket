@page
@model supermarket.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-lg p-4 text-center" style="max-width: 400px; width: 100%;">
        <i class="bi bi-door-closed" style="font-size: 3rem; color: #dc3545;"></i>
        <h3 class="mt-3">You have been logged out</h3>
        <p class="text-muted">Thanks for using our supermarket system</p>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary mt-3">
            <i class="bi bi-box-arrow-in-right"></i> Login again
        </a>
    </div>
</div>
