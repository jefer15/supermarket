@page
@model supermarket.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center vh-70 bg-light">
    <div class="card shadow-lg p-4" style="max-width: 350px; width: 100%;">
        <div class="text-center mb-3">
            <i class="bi bi-box-seam" style="font-size: 2.5rem; color: #0d6efd;"></i>
            <h4 class="mt-2">Supermarket</h4>
        </div>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-2">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" placeholder="Ingrese su correo electrónico" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" type="password" placeholder="Ingrese su contraseña" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-2">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </button>

            <div class="mt-2 text-center">
                <a asp-area="Identity" asp-page="/Account/Register">¿No tienes una cuenta? Regístrate</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
